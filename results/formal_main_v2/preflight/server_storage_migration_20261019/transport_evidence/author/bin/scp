#!/share/home/u15016/XXY_CVPR/CTI-VLA/venv/bin/python -B
import importlib.util
from pathlib import Path
import sys
sys.dont_write_bytecode = True
path = Path(__file__).resolve().parent.parent / "server_transport.py"
spec = importlib.util.spec_from_file_location("_cti_transport_shim", path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
raise SystemExit(module.shim_main("scp", sys.argv[1:]))
