  "probe_program": "import hashlib,json,os,stat\nfrom pathlib import Path\nspecs=[{'arm': 'A', 'path': '/share/home/u15016/XXY_CVPR/CTI-VLA/checkpoints/formal_main_v2/libero_10/k128/seed17/A/best.pt', 'expected_sha256': '80d3182841a7ac741da6e70fde49d1d32ceb38b9db316fbeae545e757d79fa82', 'selected_update': 4500, 'validation_metric': 0.01995339525830267}, {'arm': 'B', 'path': '/share/home/u15016/XXY_CVPR/CTI-VLA/checkpoints/formal_main_v2/libero_10/k128/seed17/B/best.pt', 'expected_sha256': 'ca8145cc0179ecf2fe80d6e3abb7e81f920c7fd4e8af43755c0245425f895952', 'selected_update': 5000, 'validation_metric': 0.019920772750462806}]\nout=[]\nfor row in specs:\n p=Path(row['path'])\n for parent in [*reversed(p.parents),p]:\n  if parent.is_symlink(): raise ValueError('Symlink checkpoint path')\n fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)\n with os.fdopen(fd,'rb') as handle:\n  before=os.fstat(handle.fileno())\n  if not stat.S_ISREG(before.st_mode): raise ValueError('Not a regular selected checkpoint')\n  h=hashlib.sha256()\n  for block in iter(lambda:handle.read(8<<20),b''): h.update(block)\n  after=os.fstat(handle.fileno())\n  current=os.stat(p,follow_symlinks=False)\n  identity=lambda s:(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)\n  if not identity(before)==identity(after)==identity(current): raise ValueError('Selected checkpoint changed during hash')\n out.append(dict(arm=row['arm'],path=str(p),exists=True,bytes=after.st_size,sha256=h.hexdigest(),\n  device=after.st_dev,inode=after.st_ino,mtime_ns=after.st_mtime_ns,stable_during_hash=True))\nprint(json.dumps(out))\n",
