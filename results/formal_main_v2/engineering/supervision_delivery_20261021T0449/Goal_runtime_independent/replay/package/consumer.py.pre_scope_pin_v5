def consume(project, reference):
    p = Path(project) / reference['path']
    require(p.resolve() == p and p.is_file() and (digest(p.read_bytes()) == reference['sha256']), 'typed saved review pin')
    saved = strict(p.read_bytes())
    require(saved.get('kind') == 'goal_remaining5_typed_terminal_review', 'no legacy/CPU review substitute')
    rebuilt = review_terminal(project, saved['terminal_ref'])
    require(saved == rebuilt, 'typed terminal review does not rebuild exactly')
    return rebuilt
